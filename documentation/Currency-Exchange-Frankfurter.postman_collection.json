{
  "info": {
    "name": "Currency Exchange App - Frankfurter API",
    "description": "Investigação e testes dos endpoints da API Frankfurter (v2) usados no projeto Currency Exchange App.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.frankfurter.dev"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = (n) => { const x = new Date(); x.setDate(x.getDate()-n); return x.toISOString().slice(0,10); };",
          "pm.collectionVariables.set(\"today\", d(0));",
          "pm.collectionVariables.set(\"from7d\", d(7));",
          "pm.collectionVariables.set(\"from30d\", d(30));",
          "pm.collectionVariables.set(\"from1y\", d(365));",
          "pm.collectionVariables.set(\"from5y\", d(365*5));",
          "pm.collectionVariables.set(\"from10y\", d(365*10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Moedas",
      "item": [
        {
          "name": "Listar moedas disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status é 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type é JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Tempo de resposta < 2000ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"Corpo não vazio\", () => pm.expect(pm.response.json()).to.not.be.empty);",
                  "const b = pm.response.json(); console.log(\"FORMATO currencies:\", Array.isArray(b) ? \"array\" : \"objeto\", JSON.stringify(b).slice(0,300));",
                  "pm.test(\"Inclui EUR, USD e BRL\", () => { const t = JSON.stringify(pm.response.json()); [\"EUR\",\"USD\",\"BRL\"].forEach(c => pm.expect(t).to.include(c)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Usado para popular os selects de moeda de origem/destino.",
            "url": {
              "raw": "{{baseUrl}}/v2/currencies",
              "host": [
