{
  "name": "Hermes",
  "font": {"family": "Manrope", "weights": [400, 600, 700], "google": "https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap"},
  "color": {
    "navy": "#0B1220", "blue": "#2563EB", "blueHover": "#1D4ED8", "sky": "#38BDF8",
    "canvas": "#F5F7FA", "surface": "#FFFFFF", "border": "#E2E8F0",
    "muted": "#64748B", "textSecondary": "#475569",
    "positive": "#16A34A", "positiveText": "#15803D", "negative": "#DC2626",
    "disabledBg": "#F1F5F9", "disabledText": "#94A3B8"
  },
  "type": {
    "display": {"size": [40, 36, 32], "weight": 700, "note": "[desktop, tablet, mobile] valor convertido"},
    "h1": {"size": [32, 30, 28], "weight": 700},
    "h2": {"size": [24, 24, 22], "weight": 700},
    "h3": {"size": 18, "weight": 600},
    "body": {"size": 16, "weight": 400},
    "bodySm": {"size": 15, "weight": 400},
    "label": {"size": 13, "weight": 600},
    "eyebrow": {"size": 13, "weight": 600, "uppercase": true, "letterSpacing": "0.06em", "color": "muted"}
  },
  "space": {"xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "2xl": 48, "3xl": 64},
  "radius": {"input": 10, "button": 10, "container": 12, "large": 14},
  "control": {"height": 48, "paddingX": 16, "borderWidth": 1, "periodPillHeight": 40, "periodPillMinWidth": 48, "swapButton": 48},
  "breakpoints": {"mobile": "0-767", "tablet": "768-1023", "desktop": "1024+"},
  "grid": {"desktop": {"cols": 12, "gutter": 24, "margin": 32, "maxWidth": 1200}, "tablet": {"cols": 8, "gutter": 20, "margin": 24}, "mobile": {"cols": 1, "gutter": 16, "margin": 16}},
  "frames": {"desktop": [1440, 1024], "tablet": [768, 1024], "mobile": [390, 844]},
  "chart": {"line": "#2563EB", "lineWidth": 2.5, "area": "#2563EB", "areaOpacity": 0.07, "grid": "#E2E8F0", "axisText": "#64748B", "axisFontSize": 13, "height": {"desktop": "320-400", "mobile": "260-300"}, "tooltip": {"bg": "#FFFFFF", "border": "#E2E8F0", "radius": 10}}
}
